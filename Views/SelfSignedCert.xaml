<UserControl x:Class="CertTool.Views.SelfSignedCert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewModels="clr-namespace:CertTool.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:SelfSignedCertViewModel}"
        Background="Transparent" Foreground="White">
    
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource PurpleHoverButton}"/>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- <Label Grid.Row="0" Grid.Column="0"   -->
            <!--    Name="FileLabel" FontSize="16"  -->
            <!--    Content="GetToken"   -->
            <!--    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,20,0,0" Width="350" -->
            <!--    Foreground="White"/> -->
            <!-- -->
            <!-- <Button Grid.Row="0" -->
            <!--         Grid.Column="1" -->
            <!--         Padding="5" Width="110" Height="30" -->
            <!--         Content="GetToken!" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" -->
            <!--         Command="{Binding TokenCommand}"                 -->
            <!--         Background="Black" Foreground="White" -->
            <!--         FontSize="12" FontWeight="Bold" -->
            <!--         BorderThickness="0" BorderBrush="#666666"/> -->
            
            <Label Grid.Row="0" Grid.Column="0"  
                   Name="FileLabel2" FontSize="16" 
                   Content="Generate Certificate"  
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,20,0,0" Width="350"
                   Foreground="White"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Padding="5" Width="110" Height="30"
                    Content="Certificate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0"
                    Command="{Binding SelfSignedCertCommand}"                
                    Background="Black" Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    BorderThickness="0" BorderBrush="#666666"/>
            
            <Label Content="Hostname:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0"
                   Foreground="White" Grid.Row="1" Grid.Column="0" />

            <TextBox Name="Hostname" Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" 
                     TextAlignment="Left" VerticalAlignment="Top" Height="25" Width="200" Margin="0,5,0,0"
                     Background="#333333" Padding="5,3,2,0" Foreground="White"
                     BorderBrush="#555555" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"/>

            <Label Content="Root pwd" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0"
                   Foreground="White" Grid.Row="2" Grid.Column="0" />

            <TextBox Name="RootPwd" Text="{Binding RootPwd, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" 
                     TextAlignment="Left" VerticalAlignment="Top" Height="25" Width="200" Margin="0,5,0,0"
                     Background="#333333" Padding="5,3,2,0" Foreground="White" BorderBrush="#555555" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>
            

            <Label Content="Cert pwd:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="15,0,0,0" Foreground="White" Grid.Row="3" Grid.Column="0" />
        
            <TextBox Name="CrtPwd" Text="{Binding CertPwd, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"                  
                     TextAlignment="Left" VerticalAlignment="Top" Height="25" Width="200" Margin="0,5,0,0"
                     Background="#333333" Padding="5,3,2,0" Foreground="White" BorderBrush="#555555" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"/>
            
         


    </Grid>
</UserControl>
