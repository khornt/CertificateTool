<Window x:Class="CertTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vms="clr-namespace:CertTool.ViewModels"
        xmlns:views="clr-namespace:CertTool.Views"
        Background="#1E1E1E" Foreground="White"
        d:DataContext="{d:DesignInstance Type=vms:MainViewModel}"
        Title="Certificate Manager" Height="680" Width="580">

        <Window.Resources>
        
        <Style TargetType="Button" BasedOn="{StaticResource PurpleHoverButton}"/>

        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Margin="0" 
                                  
                                  x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/Images/PemBackground.png" Stretch="UniformToFill"/>
        </Grid.Background>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="600"/>
        </Grid.RowDefinitions>

    
        <StackPanel>
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="600"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PurpleHoverButton}"
                        Padding="5" Width="120" Height="30"
                        Content="PemConverter" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                        Command="{Binding PemConverterCommand}"                
                        Background="Black" Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        BorderThickness="0" BorderBrush="#666666"/>
                
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PurpleHoverButton}"
                        Padding="5" Width="120" Height="30"
                        Content="Selfsigned Cert." HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,10,0,0"
                        Command="{Binding SelfSignedCertPageCommand}"                
                        Background="Black" Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        BorderThickness="0" BorderBrush="#666666"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PurpleHoverButton}"
                        Padding="5" Width="120" Height="30"
                        Content="Create Certificate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,10,0,0"
                        Command="{Binding TestPageCommand}"                
                        Background="Black" Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        BorderThickness="0" BorderBrush="#666666"/>

                


            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.Resources>
        
                    <DataTemplate DataType="{x:Type vms:PemConverterViewModel}" >
                        <views:PemConverterView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vms:CreateCertificateViewModel}">
                        <views:CreateCertificateView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vms:SelfSignedCertViewModel}">
                        <views:SelfSignedCert />
                    </DataTemplate>


                </Grid.Resources>
            <ContentControl Content="{Binding CurrentViewModel}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
